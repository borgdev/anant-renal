node_modules/
dist/
*.log
.DS_Store
.env
.env.*
coverage/
.vitest/

# Next.js
.next/
out/
*.tsbuildinfo
next-env.d.ts.bak

# Rust liquid engine (native/)
native/**/target/
native/liquid-wasm/pkg/
.harness/liquid/
# Derived measure store (regenerate with: npm run measures:seed)
.harness/measures/
# Local runtime state (SQLite store, generated realm knowledge, pack audit)
.harness/data/
packs/.authoring-audit.jsonl
# Knowledge layer — every file under it is runtime-derived: the registry caches
# (sources.json / subscriptions.json) are rebuilt from the pack catalog on each
# boot, the per-source trees are written by the knowledge sync jobs, and the
# secret store holds credentials. Track the code; never this state.
.harness/knowledge/
# Tool scratch
.codekura/
# Reference archives
renal-swarm-intelligence-source-*.zip

# Reference tree — external hosting/project state
renal-swarm-intelligence/.openai/

# Python bytecode caches (repo tooling: add_copyright.py and friends)
__pycache__/
*.py[cod]

# S2 — the Synthea checkout and the populations generated from it. Both are BUILD
# ARTIFACTS, not sources: the checkout is a clone of an external project, and a
# population is reproduced from its manifest (seed + reference date + generator
# version) rather than committed. Committing either would put a third-party tree
# and hundreds of generated FHIR files under our copyright header regime.
.harness/synthea/
synthea-population/
