    "id": "nlm.vsac",
    "name": "NLM VSAC (Value Set Authority Center)",
    "publisher": "NLM",
    "category": "terminology",
    "tier": "api-key",
    "format": "fhir-json",
    "cadence": "weekly",
    "homepage": "https://vsac.nlm.nih.gov/",
    "license": "Free with UMLS License Agreement",
    "description": "Authoritative expansions of every eCQM value set. Required to fully evaluate CMS quality measures.",
    "clinicalDomains": [
      "all"
    ],
    "requires": {
      "credentialName": "UMLS_API_KEY",
      "credentialSetup": {
        "registerUrl": "https://uts.nlm.nih.gov/uts/signup-login",
        "registerLabel": "Create UMLS Terminology Services account",
        "estimatedTime": "Up to 3 business days for UMLS license approval",
        "cost": "Free",
        "steps": [
          {
            "text": "Go to UMLS Terminology Services and create an account.",
            "link": {
              "label": "UTS Sign-up",
              "url": "https://uts.nlm.nih.gov/uts/signup-login"
            }
          },
          {
            "text": "Accept the UMLS Metathesaurus License Agreement (personal use for healthcare or research)."
          },
          {
            "text": "Wait for NLM approval email (typically 1–3 business days)."
          },
          {
            "text": "After approval, sign in at UTS → click your profile → open the \"My Profile\" page.",
            "link": {
              "label": "UTS My Profile",
              "url": "https://uts.nlm.nih.gov/uts/profile"
            }
          },
          {
            "text": "Copy your API Key from the \"UMLS Licensee Profile\" section."
          },
          {
            "text": "Paste the key into the field on the right and click Test."
          }
        ],
        "fields": [
          {
            "name": "UMLS_API_KEY",
            "label": "UMLS API Key",
            "kind": "apiKey",
            "placeholder": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
            "required": true
          }
        ],
        "testEndpoint": {
          "method": "GET",
          "url": "https://cts.nlm.nih.gov/fhir/CodeSystem?_summary=count",
          "expectStatus": [
            200
          ]
        },
        "notes": [
          "The same UMLS API key unlocks VSAC, UMLS, LOINC, and SNOMED via NLM."
        ]
      }
    },
    "fetchConfig": {
      "base": "https://cts.nlm.nih.gov/fhir"
    }
  },
