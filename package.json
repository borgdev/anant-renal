{
  "name": "@bayyagari86/healthcare-harness",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Model-agnostic, hypergraph-native healthcare agent harness with production-grade access, policy, audit, temporal, and pack contracts.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/src/server/prod.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch src/server/dev.ts",
    "ui:snapshots": "tsx scripts/build-admin-snapshots.ts",
    "measures:seed": "node scripts/seed-measure-store.mjs",
    "demo:replay": "tsx examples/dialysis-replay.ts",
    "demo:cleanup": "node scripts/cleanup-demo.mjs",
    "storage:migrate": "node scripts/migrate-sqlite-to-postgres.mjs",
    "storage:verify": "node scripts/compare-sqlite-postgres.mjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f anant-health-app",
    "liquid:build": "cd native && cargo build --workspace",
    "liquid:test": "cd native && cargo test --workspace",
    "liquid:train": "cd native && cargo run -q -p liquid-train --",
    "liquid:wasm": "cd native/liquid-wasm && wasm-pack build --target web --out-dir pkg && cp pkg/liquid_wasm_bg.wasm pkg/liquid_wasm.js pkg/liquid_wasm.d.ts pkg/liquid_wasm_bg.wasm.d.ts ../../src/liquid/wasm/",
    "exec:install": "npm install --prefix exec-app",
    "exec:build": "npm run build --prefix exec-app",
    "exec:dev": "npm run dev --prefix exec-app"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.21.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^5.2.6",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "bullmq": "^6.0.11",
    "cql-exec-fhir": "^2.1.6",
    "cql-execution": "^3.3.2",
    "fastify": "^5.11.3",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.0",
    "testcontainers": "^12.1.0",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
